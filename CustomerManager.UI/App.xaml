<Application x:Class="CustomerManager.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CustomerManager.UI"
             xmlns:converters="clr-namespace:CustomerManager.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:DecimalMoneyConverter x:Key="DecimalMoneyConverter"/>
            <converters:BoolToCustomerDialogTitleConverter x:Key="BoolToCustomerDialogTitleConverter"/>
            <converters:DeadlineSeverityToBrushConverter x:Key="DeadlineSeverityToBrushConverter"/>
            <converters:ViewModelToNameConverter x:Key="ViewModelToNameConverter"/>
            <converters:NationalIdMaskConverter x:Key="NationalIdMaskConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Base/Tokens.xaml"/>
                <ResourceDictionary Source="/Themes/Base/Theme.Buttons.xaml"/>
                <ResourceDictionary Source="/Themes/Base/Theme.Cards.xaml"/>
                <ResourceDictionary Source="/Themes/Base/Theme.Data.xaml"/>
                <ResourceDictionary Source="/Themes/Base/Theme.Dialogs.xaml"/>
                <ResourceDictionary Source="/Themes/Base/Theme.Inputs.xaml"/>
                <ResourceDictionary Source="/Themes/Base/Theme.Lists.xaml"/>
                <ResourceDictionary Source="/Themes/Base/Theme.Navigation.xaml"/>
                <ResourceDictionary Source="/Themes/Base/Theme.Tabs.xaml"/>
                <ResourceDictionary Source="/Themes/Base/Theme.Text.xaml"/>
            </ResourceDictionary.MergedDictionaries>


        </ResourceDictionary>
    </Application.Resources>
</Application>