<UserControl x:Class="CustomerManager.Views.Pages.CreditCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==========================================
             1. BẢNG HEADER KPI QUẢN LÝ THẺ TÍN DỤNG
           ========================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Tổng số thẻ đã cấp -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="TỔNG SỐ THẺ TÍN DỤNG ĐÃ PHÁT HÀNH" Style="{StaticResource Text.Muted}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalSystemCardCount, StringFormat={}{0} Thẻ}" 
                               Foreground="{DynamicResource Primary}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Tổng hạn mức cấp -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="TỔNG HẠN MỨC THẺ ĐÃ CẤP" Style="{StaticResource Text.Muted}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalSystemCreditLimit, StringFormat={}{0:N0} VNĐ}" 
                               Foreground="#38BDF8" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Phân loại hình thức phát hành -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="PHÂN LOẠI QUẢN LÝ RỦI RO THẺ" Style="{StaticResource Text.Muted}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="Cầm cố STK / Thế chấp TSĐB / Tín chấp" 
                               Foreground="{DynamicResource Success}" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==========================================
             2. GIAO DIỆN MASTER - DETAIL QUẢN LÝ THẺ
           ========================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- BÊN TRÁI: DATAGRID DANH SÁCH THẺ TÍN DỤNG -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="DANH SÁCH THẺ TÍN DỤNG BANKER QUẢN LÝ" Style="{StaticResource Text.Header}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="+ LÀM MỚI FORM" Style="{StaticResource OutlinePrimaryButton}" 
                                Height="34" Padding="10,0" Command="{Binding ClearFormCommand}"/>
                    </DockPanel>

                    <DataGrid Style="{StaticResource AppDataGrid}" 
                              ItemsSource="{Binding CreditCards}" 
                              SelectedItem="{Binding SelectedCard}" 
                              IsReadOnly="True" 
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SỐ THẺ / MÃ THẺ" Binding="{Binding CardNumber}" Width="150"/>
                            <DataGridTextColumn Header="KHÁCH HÀNG" Binding="{Binding CustomerName}" Width="1.3*"/>
                            <DataGridTextColumn Header="HẠN MỨC (VNĐ)" Binding="{Binding CreditLimit, StringFormat={}{0:N0} VNĐ}" Width="140"/>
                            <DataGridTextColumn Header="HÌNH THỨC PHÁT HÀNH" Binding="{Binding IssuanceTypeDisplay}" Width="1.4*"/>
                            <DataGridTextColumn Header="TSĐB THẾ CHẤP" Binding="{Binding CollateralSummary}" Width="1.4*"/>
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- BÊN PHẢI: FORM PHÁT HÀNH VÀ CẬP NHẬT THẺ TÍN DỤNG -->
            <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="KHOAN VAY &amp; PHÁT HÀNH THẺ TÍN DỤNG" Style="{StaticResource Text.Title}" Foreground="{DynamicResource Primary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Cấp hạn mức thẻ tín dụng theo TSĐB hoặc Tín chấp" Foreground="{DynamicResource OnSurfaceSecondary}" FontSize="12" Margin="0,0,0,20"/>

                        <!-- KHÁCH HÀNG -->
                        <TextBlock Text="Khách hàng phát hành thẻ *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" Height="40" Margin="0,0,0,12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullName}" Foreground="{DynamicResource InputFg}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- LOẠI THẺ TÍN DỤNG -->
                        <TextBlock Text="Loại Thẻ Tín Dụng *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CardTypeOptions}" SelectedIndex="{Binding CardTypeIndex}" Height="40" Margin="0,0,0,12"/>

                        <!-- HÌNH THỨC PHÁT HÀNH THẺ -->
                        <TextBlock Text="Hình thức phát hành thẻ *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding IssuanceTypeOptions}" SelectedIndex="{Binding IssuanceTypeIndex}" Height="40" Margin="0,0,0,12"/>

                        <!-- LIÊN KẾT TSĐB (CHỈ HIỂN THỊ KHI MỞ THẺ THEO DIỆN QUAN HỆ TÍN DỤNG / THẾ CHẤP TSĐB) -->
                        <StackPanel Visibility="{Binding IsCollateralRequired, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
                            <Border Background="#1E293B" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="LIÊN KẾT TSĐB BẢO ĐẢM HẠN MỨC THẺ" Style="{StaticResource LabelText}" Foreground="#38BDF8" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding AvailableCollaterals}" SelectedItem="{Binding SelectedCollateral}" Height="40">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplaySummary}" Foreground="{DynamicResource InputFg}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="💡 Hạn mức thẻ sẽ tự động cộng dồn vào Tổng nghĩa vụ bảo đảm để tính LTV Vay Thực Tế ở Tab TSĐB." 
                                               Foreground="{DynamicResource OnSurfaceSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- HẠN MỨC CẤP THẺ -->
                        <TextBlock Text="Hạn mức cấp Thẻ (VNĐ) *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding CreditLimitInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <!-- LÃI SUẤT THẺ -->
                        <TextBlock Text="Lãi suất thẻ tín dụng (%/năm)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InterestRate}" Margin="0,0,0,16"/>

                        <!-- SỐ THẺ / MÃ THẺ -->
                        <TextBlock Text="Số thẻ / Mã định danh Thẻ" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding CardNumberInput}" Tag="Tự động sinh số thẻ nếu bỏ trống..." Margin="0,0,0,24"/>

                        <!-- NÚT LƯU & XOÁ THẺ -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                    Content="{Binding SubmitButtonText}" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Height="46" Margin="0,0,8,0"
                                    Command="{Binding SaveOrUpdateCardCommand}"/>

                            <Button Grid.Column="1" 
                                    Content="🗑️ XOÁ THẺ" 
                                    Style="{StaticResource DangerButton}" 
                                    Height="46" Width="110"
                                    Command="{Binding DeleteCardCommand}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
