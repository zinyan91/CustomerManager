# Sao chép file này thành .env và điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit file .env lên git.

# Supabase project URL (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Project Settings > API).
# Key này lộ ra phía client là bình thường — an toàn PHỤ THUỘC HOÀN TOÀN
# vào việc bật Row Level Security (RLS) trên mọi bảng.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Chuỗi kết nối Postgres cho serverless function trong api/ (chỉ dùng phía server).
# Dùng tài khoản chuyên dụng quyền tối thiểu — KHÔNG dùng superuser "postgres".
# Khai báo giá trị này trong Vercel Environment Variables, không để trong repo.
DATABASE_URL=postgres://app_user:password@db.your-project-ref.supabase.co:5432/postgres
