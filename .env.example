# Sao chép file này thành .env và điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit file .env lên git.

# Supabase project URL (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Project Settings > API).
# Key này lộ ra phía client là bình thường — an toàn PHỤ THUỘC HOÀN TOÀN
# vào việc bật Row Level Security (RLS) trên mọi bảng.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare R2 Object Storage (Lưu trữ tệp, ảnh TSĐB, tài liệu - 0 USD phí Egress Bandwidth)
# Public bucket URL hoặc Custom Domain (ví dụ: https://cdn.customermanager.vn hoặc https://pub-xxx.r2.dev)
VITE_R2_PUBLIC_URL=https://your-r2-public-domain-or-pub-url.r2.dev
# Tên bucket R2
VITE_R2_BUCKET_NAME=customer-manager-assets
