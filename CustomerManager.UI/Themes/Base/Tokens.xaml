<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Design Tokens & Radii -->
    <CornerRadius x:Key="R.Card">12</CornerRadius>
    <CornerRadius x:Key="R.Button">8</CornerRadius>
    <CornerRadius x:Key="R.Pill">999</CornerRadius>

    <sys:Double x:Key="Btn.FontSize">13</sys:Double>
    <Thickness  x:Key="Btn.Padding">14,8,14,8</Thickness>
    <Thickness  x:Key="Btn.Margin">4,4,4,4</Thickness>
    <sys:Double x:Key="Btn.Height">40</sys:Double>

    <BooleanToVisibilityConverter x:Key="B2V"/>

    <!-- Modern Ultra High-Contrast Slate Dark Palette -->
    <SolidColorBrush x:Key="BgApp" Color="#0B0F19"/>               <!-- Nền ứng dụng siêu sâu -->
    <SolidColorBrush x:Key="Surface" Color="#111827"/>             <!-- Sidebar Surface -->
    <SolidColorBrush x:Key="Surface2" Color="#1F2937"/>            <!-- Hover Surface -->
    <SolidColorBrush x:Key="BgCard" Color="#151E2E"/>              <!-- Card Background -->
    <SolidColorBrush x:Key="BdCard" Color="#2A364F"/>              <!-- Viền Card sáng rõ -->

    <SolidColorBrush x:Key="Primary" Color="#38BDF8"/>             <!-- Sky Blue Sáng Rực -->
    <SolidColorBrush x:Key="PrimaryHover" Color="#0284C7"/>
    <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF"/>           <!-- Chữ trên Primary: Trắng tinh -->

    <SolidColorBrush x:Key="Success" Color="#34D399"/>             <!-- Emerald Green -->
    <SolidColorBrush x:Key="Warning" Color="#FBBF24"/>             <!-- Amber Warning -->
    <SolidColorBrush x:Key="Danger" Color="#F87171"/>              <!-- Red Danger -->

    <!-- HỆ THỐNG CHỮ NỔI BẬT KHÔNG BỊ CHÌM 100% -->
    <SolidColorBrush x:Key="OnSurface" Color="#FFFFFF"/>           <!-- Chữ trắng nổi bật 100% -->
    <SolidColorBrush x:Key="OnSurfacePrimary" Color="#FFFFFF"/>    <!-- Chữ tiêu đề trắng sáng -->
    <SolidColorBrush x:Key="OnSurfaceSecondary" Color="#CBD5E1"/>  <!-- Chữ phụ bạc sáng rõ -->
    <SolidColorBrush x:Key="OnSurfaceMuted" Color="#94A3B8"/>      <!-- Chữ phụ nhạt -->

    <SolidColorBrush x:Key="InputBg" Color="#0B0F17"/>             <!-- Nền ô nhập liệu -->
    <SolidColorBrush x:Key="InputFg" Color="#FFFFFF"/>             <!-- Chữ nhập liệu trắng nổi -->
    <SolidColorBrush x:Key="InputBorder" Color="#334155"/>         <!-- Viền ô nhập liệu -->

    <SolidColorBrush x:Key="BtnBg" Color="#1E293B"/>               <!-- Nền nút mặc định -->
    <SolidColorBrush x:Key="BtnBorder" Color="#38BDF8"/>           <!-- Viền nút mặc định: Xanh Sky -->
    <SolidColorBrush x:Key="BtnBgHover" Color="#334155"/>          <!-- Nền nút hover -->

    <SolidColorBrush x:Key="SelectionBg" Color="#0284C7"/>         <!-- Nền dòng được chọn -->
    <SolidColorBrush x:Key="SelectionFg" Color="#FFFFFF"/>         <!-- Chữ dòng được chọn -->

</ResourceDictionary>
