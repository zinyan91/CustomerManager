<UserControl x:Class="CustomerManager.UI.UI.DialogShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="{DynamicResource BgApp}">

    <Grid Margin="14" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Main content -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Subtitle, ElementName=Root}" Opacity="0.75" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Subtitle, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Subtitle, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Main content -->
        <Border Grid.Row="1"
                CornerRadius="12"
                Padding="12"
                BorderThickness="1"
                BorderBrush="{DynamicResource BdCard}"
                Background="{DynamicResource BgCard}">
            <ContentPresenter Content="{Binding MainContent, ElementName=Root}"/>
        </Border>

        <!-- Toolbar (optional) -->
        <Border Grid.Row="2"
                Margin="0,12,0,12"
                CornerRadius="12"
                Padding="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource BdCard}"
                Background="{DynamicResource BgCard}">
            <ContentPresenter Content="{Binding ToolbarContent, ElementName=Root}"/>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ContentPresenter Grid.Column="0"
                              VerticalAlignment="Center"
                              Content="{Binding StatusContent, ElementName=Root}"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <ContentPresenter Content="{Binding FooterRightContent, ElementName=Root}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
