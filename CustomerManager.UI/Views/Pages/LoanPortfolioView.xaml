<UserControl x:Class="CustomerManager.Views.Pages.LoanPortfolioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==========================================
             1. BẢNG THỐNG KÊ THÔNG SỐ TÍN DỤNG BANKER
           ========================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Tổng hạn mức cấp toàn hệ thống -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="TỔNG HẠN MỨC CẤP TÍN DỤNG" Style="{StaticResource Text.Muted}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalSystemContractAmount, StringFormat={}{0:N0} VNĐ, FallbackValue='0 VNĐ'}" 
                               Foreground="{DynamicResource Primary}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Tổng dư nợ hiện hữu thực tế toàn danh mục KUNN -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="DƯ NỢ HIỆN HỮU THỰC TẾ (TẤT CẢ KUNN)" Style="{StaticResource Text.Muted}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalSystemCurrentBalance, StringFormat={}{0:N0} VNĐ, FallbackValue='0 VNĐ'}" 
                               Foreground="#38BDF8" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Tổng hạn mức khả dụng còn lại -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="4,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="HẠN MỨC KHẢ DỤNG CÒN LẠI" Style="{StaticResource Text.Muted}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalSystemAvailableLimit, StringFormat={}{0:N0} VNĐ, FallbackValue='0 VNĐ'}" 
                               Foreground="{DynamicResource Success}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Phân loại nhóm nợ toàn hệ thống -->
            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="4,0,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="PHÂN LOẠI NHÓM NỢ BANK" Style="{StaticResource Text.Muted}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalSystemDebtGroupDisplay, FallbackValue='Nhóm 1 (Đủ tiêu chuẩn)'}" 
                               Foreground="#F59E0B" FontSize="15" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==========================================
             2. GIAO DIỆN MASTER - DETAIL QUẢN LÝ
           ========================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BÊN TRÁI: DANH SÁCH HỢP ĐỒNG & KHOẢN VAY -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <DockPanel>
                    <!-- 1. THANH CÔNG CỤ TRA CỨU HĐTD ĐA NĂNG (CIF, HỌ TÊN KH, SỐ HĐ/STK VAY) -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="+ MỚI" Style="{StaticResource PrimaryButton}" 
                                        Width="70" Height="30" Command="{Binding ClearFormCommand}"/>
                                <TextBlock Text="TRA CỨU HỢP ĐỒNG TÍN DỤNG" Style="{StaticResource Text.Header}" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource WatermarkTextBox}" Tag="Mã CIF KH..." Margin="0,0,4,0"
                                         Text="{Binding SearchCif, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource WatermarkTextBox}" Tag="Họ tên KH..." Margin="4,0,0,0"
                                         Text="{Binding SearchCustomerName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource WatermarkTextBox}" Tag="Số HĐTD / STK vay..." Margin="0,0,6,0"
                                         Text="{Binding SearchContractOrAccount, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilterType}" Width="120" Height="36"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="DANH SÁCH HỢP ĐỒNG &amp; GNN" Style="{StaticResource Text.Header}" Margin="0,0,0,8"/>
                    
                    <!-- Hộp thông báo khi chưa chọn Khách hàng -->
                    <Border Visibility="{Binding HasNoContracts, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BdCard}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,0" VerticalAlignment="Top">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔍 CHƯA CHỌN KHÁCH HÀNG" FontWeight="Bold" Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Vui lòng chọn Khách hàng trên ô phía trên để tra cứu danh sách Hợp đồng tín dụng &amp; Giấy nhận nợ (KUNN)." 
                                       TextWrapping="Wrap" Foreground="{DynamicResource OnSurfaceSecondary}" FontSize="12" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding Contracts}" SelectedItem="{Binding SelectedContract}" 
                             Style="{StaticResource List.Flat}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MasterDetail.ListItem}"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ContractNumber}" FontWeight="Bold" Foreground="#38BDF8"/>
                                            <Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0" Background="#334155" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ContractTypeDisplay}" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CustomerName}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding ContractAmount, StringFormat={}{0:N0} VNĐ}" Foreground="{DynamicResource Success}" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Background="#1E293B">
                                        <TextBlock Text="{Binding Drawdowns.Count, StringFormat={}{0} GNN}" Foreground="#F8FAFC" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- BÊN PHẢI: CHI TIẾT & TAB KHAI THÁC KHOẢN VAY -->
            <Border Grid.Column="1" Style="{StaticResource MasterDetail.DetailCard}">
                <TabControl Style="{StaticResource AppTabControl}">

                    <!-- TAB 1: THÔNG TIN HỢP ĐỒNG & RÚT VỐN GNN -->
                    <TabItem Header="📋 THÔNG TIN HỢP ĐỒNG &amp; RÚT VỐN GNN">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                            <StackPanel Margin="0,8,0,0">
                                
                                <!-- BẢNG 1: THÔNG TIN HỢP ĐỒNG TÍN DỤNG TỔNG -->
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="➕ TẠO HĐ" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,0,6,0" Command="{Binding CreateContractCommand}"/>
                                        <Button Content="✏️ SỬA HĐ" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,6,0" Command="{Binding UpdateContractCommand}"/>
                                        <Button Content="🗑️ XOÁ HĐ" Style="{StaticResource DangerButton}" Height="34" Command="{Binding DeleteContractCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="1. THÔNG TIN HỢP ĐỒNG TÍN DỤNG TỔNG" Style="{StaticResource Text.Header}" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Khách hàng -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                            <TextBlock Text="Khách hàng vay *" Style="{StaticResource LabelText}"/>
                                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" Height="40" Margin="0,4,0,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding FullName}" Foreground="{DynamicResource InputFg}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Loại hình cho vay -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,10">
                                            <TextBlock Text="Loại hình tín dụng *" Style="{StaticResource LabelText}"/>
                                            <ComboBox SelectedIndex="{Binding ContractTypeIndex}" Height="40" Margin="0,4,0,0">
                                                <ComboBoxItem Content="Hạn Mức Tín Dụng (Revolving Facility)"/>
                                                <ComboBoxItem Content="Cho Vay Từng Lần (Term Loan)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Hạn HĐTD (Ngày hết hạn HĐTD) -->
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,10">
                                            <TextBlock Text="Hạn HĐTD *" Style="{StaticResource LabelText}"/>
                                            <DatePicker SelectedDate="{Binding HdtdDueDate}" Height="40" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Tổng hạn mức cấp -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,0">
                                            <DockPanel>
                                                <TextBlock Text="HM Cấp Tối Đa theo TSĐB: " Style="{StaticResource LabelText}" FontSize="11" Foreground="#38BDF8" DockPanel.Dock="Left"/>
                                                <TextBlock Text="{Binding MaxContractAmountDisplay}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </DockPanel>
                                            <TextBox x:Name="TxtContractAmount" Text="{Binding ContractAmountInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsContractAmountExceeded}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Text="{Binding ContractAmountWarningMessage}" Foreground="#EF4444" FontSize="11" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Tài sản bảo đảm thế chấp -->
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock Text="Tài sản bảo đảm thế chấp *" Style="{StaticResource LabelText}"/>
                                            <ComboBox ItemsSource="{Binding AvailableCollaterals}" SelectedItem="{Binding SelectedCollateral}" Height="40" Margin="0,4,0,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplaySummary}" Foreground="{DynamicResource InputFg}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- BẢNG 2: CHI TIẾT GIẤY NHẬN NỢ (GNN) & CƠ CẤU LÃI SUẤT -->
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="⚡ RÚT VỐN GNN" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,0,6,0" Command="{Binding CreateGnnCommand}"/>
                                        <Button Content="✏️ SỬA GNN" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,6,0" Command="{Binding UpdateGnnCommand}"/>
                                        <Button Content="🗑️ XOÁ GNN" Style="{StaticResource DangerButton}" Height="34" Command="{Binding DeleteGnnCommand}"/>
                                    </StackPanel>
                                    <TextBlock Text="2. CẤU TRÚC GIẤY NHẬN NỢ (GNN) &amp; LÃI SUẤT" Style="{StaticResource Text.Header}" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- THANH CHỌN GNN KHI HĐTD CÓ NHIỀU GNN (CHỈ HIỂN THỊ VỚI HẠN MỨC TÍN DỤNG) -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHmtdContract}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <TextBlock Text="Chọn Giấy Nhận Nợ (GNN): " Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                        <ComboBox ItemsSource="{Binding Loans}" SelectedItem="{Binding SelectedLoan}" Height="38">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplaySummary}" Foreground="{DynamicResource InputFg}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Số tiền nhận nợ -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                            <TextBlock Text="Số tiền nhận nợ (VNĐ) *" Style="{StaticResource LabelText}"/>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding GnnAmountInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Dư nợ hiện hữu -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,10">
                                            <TextBlock Text="Dư nợ hiện hữu (VNĐ)" Style="{StaticResource LabelText}"/>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding SelectedLoan.CurrentOutstandingBalance, Mode=OneWay, StringFormat={}{0:N0}}" IsReadOnly="True" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Loại lãi suất -->
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,10">
                                            <TextBlock Text="Loại Lãi suất *" Style="{StaticResource LabelText}"/>
                                            <ComboBox SelectedIndex="{Binding RateTypeIndex}" Height="40" Margin="0,4,0,0">
                                                <ComboBoxItem Content="1. Lãi suất Ưu đãi"/>
                                                <ComboBoxItem Content="2. Lãi suất Thả nổi (Base + Margin)"/>
                                                <ComboBoxItem Content="3. Lãi suất Cố định / Thông thường"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Thông số Lãi suất -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                            <TextBlock Text="Lãi suất ưu đãi (%/năm)" Style="{StaticResource LabelText}"/>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding PreferentialRate}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,8,10">
                                            <TextBlock Text="Số tháng ưu đãi" Style="{StaticResource LabelText}"/>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding PreferentialMonths}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,10">
                                            <TextBlock Text="LS Cơ sở + Biên độ (%/năm)" Style="{StaticResource LabelText}"/>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Style="{StaticResource InputTextBox}" Text="{Binding BaseRate}" ToolTip="Lãi suất cơ sở"/>
                                                <TextBlock Grid.Column="1" Text=" + " VerticalAlignment="Center" Foreground="#94A3B8" FontWeight="Bold"/>
                                                <TextBox Grid.Column="2" Style="{StaticResource InputTextBox}" Text="{Binding MarginRate}" ToolTip="Biên độ cộng thêm"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Thời hạn GNN, Ân hạn gốc & Ngày trả nợ hàng tháng -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                                            <TextBlock Text="Thời hạn GNN (Tháng) *" Style="{StaticResource LabelText}"/>
                                            <ComboBox ItemsSource="{Binding GnnTermOptions}" SelectedItem="{Binding TermMonths}" Height="40" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Ân hạn gốc (Chỉ cho Vay từng lần) -->
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,8,10">
                                            <TextBlock Text="Ân hạn gốc (Tháng)" Style="{StaticResource LabelText}"/>
                                            <ComboBox ItemsSource="{Binding GracePeriodOptions}" 
                                                      SelectedItem="{Binding GraceMonths}" 
                                                      IsEnabled="{Binding IsTermLoanType}" 
                                                      Height="40" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Ngày trả nợ hàng tháng (Linh hoạt: ví dụ ngày 15) -->
                                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="8,0,0,10">
                                            <TextBlock Text="Ngày trả nợ hàng tháng *" Style="{StaticResource LabelText}"/>
                                            <ComboBox ItemsSource="{Binding RepaymentDayOptions}" SelectedItem="{Binding RepaymentDayOfMonth}" Height="40" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Ngày giải ngân, Hạn KUNN & LTV -->
                                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Ngày giải ngân *" Style="{StaticResource LabelText}"/>
                                            <DatePicker SelectedDate="{Binding DisbursementDate}" Height="40" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,8,0">
                                            <TextBlock Text="Hạn KUNN (Tự động)" Style="{StaticResource LabelText}"/>
                                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding SelectedLoan.KunnDueDate, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy}}" IsReadOnly="True" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock Text="LTV Vay Thực Tế" Style="{StaticResource LabelText}"/>
                                            <Border Background="#1E293B" CornerRadius="8" Height="40" Margin="0,4,0,0" Padding="10,0">
                                                <TextBlock Text="{Binding CalculatedLtvPercent, StringFormat={}{0}%}" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- CẢNH BÁO LTV -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding LtvWarningMessage}" Foreground="#F59E0B" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: QUẢN LÝ LỊCH THU NỢ & HẠCH TOÁN THU NỢ / TRẢ NỢ TRƯỚC HẠN -->
                    <TabItem Header="💵 LỊCH THU NỢ TỰ ĐỘNG &amp; HẠCH TOÁN">
                        <DockPanel Margin="0,8,0,0">
                            
                            <!-- THANH THAO TÁC HẠCH TOÁN -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Nút Phê duyệt & Giải ngân GNN -->
                                <Button Grid.Column="0" Content="⚡ GIẢI NGÂN GNN" Style="{StaticResource PrimaryButton}" 
                                        Width="180" Height="40" Command="{Binding DisburseGnnCommand}"/>

                                <!-- Trả nợ trước hạn -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Trả nợ trước hạn (VNĐ):" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding PrepaymentAmountInput, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="40" Margin="0,0,8,0"/>
                                    <Button Content="💰 HẠCH TOÁN TRẢ TRƯỚC HẠN" Style="{StaticResource SecondaryButton}" Height="40" Command="{Binding RecordPrepaymentCommand}"/>
                                </StackPanel>

                                <!-- Nút Thu nợ kỳ đang chọn -->
                                <Button Grid.Column="2" Content="💵 THU NỢ KỲ CHỌN" Style="{StaticResource SuccessButton}" 
                                        Width="190" Height="40" Command="{Binding CollectPaymentCommand}"/>
                            </Grid>

                            <!-- BẢNG LỊCH THU NỢ -->
                            <Border Style="{StaticResource CardBorder}">
                                <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding LoanSchedules}" 
                                          SelectedItem="{Binding SelectedSchedule}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kỳ" Binding="{Binding PeriodNumber}" Width="50"/>
                                        <DataGridTextColumn Header="Ngày đến hạn" Binding="{Binding DueDate, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                                        <DataGridTextColumn Header="Tiền gốc kỳ này" Binding="{Binding PrincipalAmount, StringFormat={}{0:N0} VNĐ}" Width="140"/>
                                        <DataGridTextColumn Header="Tiền lãi kỳ này" Binding="{Binding InterestAmount, StringFormat={}{0:N0} VNĐ}" Width="130"/>
                                        <DataGridTextColumn Header="Tổng phải trả" Binding="{Binding TotalAmount, StringFormat={}{0:N0} VNĐ}" Width="140"/>
                                        <DataGridTextColumn Header="Dư nợ còn lại" Binding="{Binding RemainingBalance, StringFormat={}{0:N0} VNĐ}" Width="140"/>
                                        <DataGridCheckBoxColumn Header="Đã thu" Binding="{Binding IsPaid}" Width="70"/>
                                        <DataGridTextColumn Header="Ngày hạch toán" Binding="{Binding PaymentDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </DockPanel>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>