<UserControl x:Class="CustomerManager.Views.Pages.CustomerListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- DANH SÁCH KHÁCH HÀNG BÊN TRÁI (TỰ ĐỘNG DÃN 100% CHIỀU CAO) -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- KHUNG TÌM KIẾM -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="DANH SÁCH HỒ SƠ KHÁCH HÀNG CÁ NHÂN" Style="{StaticResource Text.Header}" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Content="{Binding IsCccdMasked, Converter={StaticResource BoolToCustomerDialogTitleConverter}, FallbackValue='👁️ Mã hóa CCCD'}"
                                Style="{StaticResource OutlinePrimaryButton}"
                                Command="{Binding ToggleCccdMaskCommand}"
                                Padding="12,6"/>
                    </Grid>

                    <!-- 3 Ô TRA CỨU KHÁCH HÀNG THÔNG MINH -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Ô 1: Tra cứu theo Mã CIF -->
                        <TextBox Grid.Column="0" Style="{StaticResource WatermarkTextBox}" Tag="Mã CIF KH..." Margin="0,0,6,0"
                                 Text="{Binding SearchCif, UpdateSourceTrigger=PropertyChanged}"/>
                        <!-- Ô 2: Tra cứu theo Họ và tên -->
                        <TextBox Grid.Column="1" Style="{StaticResource WatermarkTextBox}" Tag="Họ và tên KH..." Margin="0,0,6,0"
                                 Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"/>
                        <!-- Ô 3: Tra cứu theo Số CCCD -->
                        <TextBox Grid.Column="2" Style="{StaticResource WatermarkTextBox}" Tag="Số CCCD KH..." Margin="0,0,6,0"
                                 Text="{Binding SearchNationalId, UpdateSourceTrigger=PropertyChanged}"/>
                        
                        <Button Grid.Column="3" Content="🔍 TÌM KIẾM" Style="{StaticResource PrimaryButton}" 
                                Command="{Binding SearchCommand}" Width="100" Margin="0,0,6,0"/>
                        <Button Grid.Column="4" Content="📥 NHẬP CSV" Style="{StaticResource OutlinePrimaryButton}" 
                                Command="{Binding ImportCustomersCommand}" Height="36" Padding="10,0" Margin="0,0,6,0"/>
                        <Button Grid.Column="5" Content="📤 XUẤT CSV" Style="{StaticResource OutlinePrimaryButton}" 
                                Command="{Binding ExportCustomersCommand}" Height="36" Padding="10,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- BẢNG DATAGRID KHÁCH HÀNG (DÃN TOÀN BỘ CHIỀU CAO MÀN HÌNH) -->
            <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                <DataGrid Style="{StaticResource AppDataGrid}" 
                          ItemsSource="{Binding Customers}" 
                          SelectedItem="{Binding SelectedCustomer}"
                          IsReadOnly="True" 
                          VerticalAlignment="Stretch" 
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <!-- Cột CIF mở rộng 130 tránh mất số -->
                        <DataGridTextColumn Header="MÃ CIF" Binding="{Binding CifKh}" Width="130"/>
                        <DataGridTextColumn Header="HỌ VÀ TÊN KH" Binding="{Binding FullName}" Width="1.3*"/>
                        <DataGridTextColumn Header="CIF KHLQ" Binding="{Binding SpouseCifDisplay}" Width="110"/>
                        <DataGridTextColumn Header="KHLQ (VỢ/CHỒNG)" Binding="{Binding SpouseNameDisplay}" Width="1.2*"/>
                        <DataGridTextColumn Header="HÔN NHÂN" Binding="{Binding MaritalStatus}" Width="110"/>
                        <DataGridTextColumn Header="XẾP HẠNG" Binding="{Binding CreditRating}" Width="90"/>
                        <DataGridTextColumn Header="ĐIỂM CIC" Binding="{Binding CreditScore}" Width="90"/>
                        <DataGridTextColumn Header="TRẠNG THÁI CIC" Binding="{Binding CicStatus}" Width="130"/>
                        <DataGridTemplateColumn Header="THAO TÁC" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="👁️ Xem" Style="{StaticResource OutlinePrimaryButton}" 
                                            Command="{Binding DataContext.ShowCustomerDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Padding="8,3" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- FORM KHỞI TẠO & CẬP NHẬT HỒ SƠ PHÁP LÝ BÊN PHẢI -->
        <Border Grid.Column="1" Style="{StaticResource CardPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="+ MỚI" Style="{StaticResource OutlinePrimaryButton}" 
                                Height="30" Padding="8,0" Command="{Binding ClearSelectionCommand}"/>
                        <TextBlock Text="{Binding SubmitButtonText}" Style="{StaticResource Text.Title}" 
                                   Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                    </DockPanel>
                    
                    <TextBlock Text="Khai báo thông tin pháp lý &amp; Khách hàng liên quan (KHLQ)" Foreground="{DynamicResource OnSurfaceSecondary}" FontSize="12" Margin="0,0,0,16"/>

                    <!-- THÔNG TIN PHÁP LÝ CÁ NHÂN -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Mã CIF *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputCif}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Số CCCD" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputNationalId}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Họ tên khách hàng *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputFullName}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Số điện thoại" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputPhone}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Thu nhập hàng tháng (VNĐ)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputMonthlyIncomeText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Số tài khoản (STK) KH" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputAccountNumber}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Địa chỉ liên lạc" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputAddress}"/>
                        </StackPanel>
                    </Grid>

                    <!-- KHUNG THÔNG TIN HÔN NHÂN & KHLQ -->
                    <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="THÔNG TIN HÔN NHÂN &amp; KHLQ" Style="{StaticResource Text.Header}" Foreground="#38BDF8" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Tình trạng hôn nhân *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding MaritalStatusOptions}" SelectedItem="{Binding InputMaritalStatus}" Height="38"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Mã CIF KHLQ" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputCifKhlq}"/>
                                </StackPanel>
                            </Grid>

                            <!-- FORM NHẬP THÔNG TIN VỢ / CHỒNG (NẾU ĐÃ KẾT HÔN) -->
                            <StackPanel Visibility="{Binding IsMarried, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Họ và tên Vợ / Chồng (KHLQ) *" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputSpouseName}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Số CCCD Vợ/Chồng" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputSpouseNationalId}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="SĐT Vợ/Chồng" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputSpousePhone}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Số tài khoản (STK) Vợ/Chồng" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputSpouseAccountNumber}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Thu nhập Vợ/Chồng (VNĐ)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding InputSpouseIncomeText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CÁC NÚT LƯU, CẬP NHẬT VÀ XOÁ -->
                    <DockPanel Margin="0,0,0,10">
                        <Button Content="{Binding SubmitButtonText}" Style="{StaticResource PrimaryButton}" 
                                Height="42" Command="{Binding SaveProfileCommand}"/>
                    </DockPanel>
                    
                    <Button Content="🗑️ XOÁ KHÁCH HÀNG" Style="{StaticResource DangerButton}" Height="36" 
                            Command="{Binding DeleteCustomerCommand}"
                            Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==========================================
             POPUP MODAL XEM CHI TIẾT THÔNG TIN KH & KHLQ
           ========================================== -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="99" Visibility="{Binding IsDetailsPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#CC0F172A"/> <!-- Backdrop mờ -->
            <Border Style="{StaticResource Card}" Width="650" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <DockPanel>
                    <!-- Header Popup -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="✖" Style="{StaticResource SecondaryButton}" Width="32" Height="32" Command="{Binding CloseDetailsPopupCommand}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedCustomerDetail.FullName, StringFormat={}HỒ SƠ CHI TIẾT: {0}}" Style="{StaticResource Text.Header}" Foreground="#38BDF8"/>
                            <TextBlock Text="{Binding SelectedCustomerDetail.CifKh, StringFormat={}Mã CIF: {0}}" Style="{StaticResource Text.Muted}" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Nội dung Chi tiết -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Nhóm 1: Thông tin cá nhân KH -->
                            <TextBlock Text="1. THÔNG TIN PHÁP LÝ &amp; LIÊN LẠC KHÁCH HÀNG" Style="{StaticResource Text.Title}" FontSize="13" Foreground="{DynamicResource Primary}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Họ và tên KH:" Style="{StaticResource Text.Muted}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCustomerDetail.FullName}" FontWeight="Bold" Foreground="#F8FAFC"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Số CCCD:" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCustomerDetail.NationalId}" Foreground="#F8FAFC" Margin="0,6,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Số tài khoản (STK):" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCustomerDetail.AccountNumber, FallbackValue='Chưa khai báo'}" Foreground="#38BDF8" FontWeight="Bold" Margin="0,6,0,0"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Số điện thoại:" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCustomerDetail.Phone, FallbackValue='Chưa khai báo'}" Foreground="#F8FAFC" Margin="0,6,0,0"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Thu nhập tháng:" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedCustomerDetail.MonthlyIncome, StringFormat={}{0:N0} VNĐ}" Foreground="{DynamicResource Success}" FontWeight="Bold" Margin="0,6,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Nhóm 2: Thông tin Hôn nhân & Khách hàng liên quan (KHLQ) -->
                            <TextBlock Text="2. THÔNG TIN HÔN NHÂN &amp; KHLQ (VỢ/CHỒNG)" Style="{StaticResource Text.Title}" FontSize="13" Foreground="#38BDF8" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource CardBorder}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Hôn nhân:" Style="{StaticResource Text.Muted}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCustomerDetail.MaritalStatus}" FontWeight="Bold" Foreground="#F8FAFC"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mã CIF KHLQ:" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCustomerDetail.SpouseCifDisplay}" Foreground="#38BDF8" FontWeight="Bold" Margin="0,6,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Họ tên Vợ/Chồng:" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCustomerDetail.SpouseNameDisplay}" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,6,0,0"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="STK Vợ/Chồng:" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCustomerDetail.SpouseAccountNumber, FallbackValue='Chưa khai báo'}" Foreground="#38BDF8" FontWeight="Bold" Margin="0,6,0,0"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="SĐT Vợ/Chồng:" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedCustomerDetail.SpousePhone, FallbackValue='Chưa khai báo'}" Foreground="#F8FAFC" Margin="0,6,0,0"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Thu nhập Vợ/Chồng:" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedCustomerDetail.SpouseIncome, StringFormat={}{0:N0} VNĐ}" Foreground="{DynamicResource Success}" FontWeight="Bold" Margin="0,6,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>