<UserControl x:Class="CustomerManager.Views.Pages.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="DASHBOARD TỔNG QUAN TÍN DỤNG CORE BANK" Style="{StaticResource Text.Title}" Margin="0,0,0,20"/>

            <!-- Card KPI Thống Kê Tổng Quan -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TỔNG DƯ NỢ ĐÃ GIẢI NGÂN" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalOutstandingAmount, StringFormat={}{0:N0} VNĐ}" Foreground="{DynamicResource Success}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Đang lưu hành" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="TỔNG GIÁ TRỊ TSĐB ĐỊNH GIÁ" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalCollateralValue, StringFormat={}{0:N0} VNĐ}" Foreground="{DynamicResource Primary}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Đã nhận thế chấp" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="TỔNG KHÁCH HÀNG (CIF)" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalCustomerCount}" Foreground="#38BDF8" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Hồ sơ quản lý" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TỔNG KHOẢN VAY / KHẾ ƯỚC" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalLoanCount}" Foreground="#F59E0B" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Hợp đồng active" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Card Phân Loại Nhóm Nợ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="PHÂN LOẠI CHẤT LƯỢNG NỢ TÍN DỤNG (THÔNG TƯ 11/2021/TT-NHNN)" Style="{StaticResource Text.Header}" Margin="0,0,0,16"/>
                    <UniformGrid Columns="3">
                        <Border Background="#064E3B" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="NHÓM 1: NỢ ĐỦ TIÊU CHUẨN" Foreground="#34D399" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Group1Count, StringFormat={}{0} Khoản vay}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Quá hạn &lt; 10 ngày" Foreground="#A7F3D0" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#78350F" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="NHÓM 2: NỢ CẦN CHÚ Ý" Foreground="#FBBF24" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Group2Count, StringFormat={}{0} Khoản vay}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Quá hạn 10 - 90 ngày" Foreground="#FDE68A" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#7F1D1D" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="NHÓM 3 - 5: NỢ XẤU / NGHỜ / MẤT VỐN" Foreground="#F87171" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Group3To5Count, StringFormat={}{0} Khoản vay}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Quá hạn &gt; 90 ngày" Foreground="#FCA5A5" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
