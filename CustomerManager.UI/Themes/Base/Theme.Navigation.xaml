<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================
         NAV LISTBOX
       ======================= -->
    <Style x:Key="NavListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BdCard}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- =======================
         NAV LIST ITEM
       ======================= -->
    <Style x:Key="NavListItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <!-- giảm “đậm” cho hợp tổng thể -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                        CornerRadius="12"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition x:Name="ColGap" Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ICON -->
                            <Path x:Name="Icon"
                              Grid.Column="0"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              Fill="{DynamicResource OnSurfaceSecondary}"
                              Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>

                            <!-- TEXT -->
                            <ContentPresenter x:Name="Txt"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Collapse sidebar => icon-only -->
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                 Value="Collapsed">
                            <Setter TargetName="Bd" Property="Padding" Value="10"/>
                            <Setter TargetName="ColGap" Property="Width" Value="0"/>
                            <Setter TargetName="Txt" Property="Visibility" Value="Collapsed"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </DataTrigger>

                        <!-- Hover: nổi nhẹ -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCard2}"/>
                            <!-- nếu muốn viền thì bật dòng dưới, nhưng mặc định KHÔNG viền cho “phẳng” -->
                            <!-- <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BdCard}"/> -->
                            <!-- <Setter TargetName="Bd" Property="BorderThickness" Value="1"/> -->
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Primary}"/>
                        </Trigger>

                        <!-- Selected: primary pill -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Primary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource OnPrimary}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =======================
         NAV LIST ITEM TEXT ONLY
       ======================= -->
    <Style x:Key="NavListItemStyle.TextOnly" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            CornerRadius="12"
                            Background="{x:Null}"
                            BorderBrush="{DynamicResource BdCard}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">

                        <!-- CHỈ TEXT -->
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCard2}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Primary}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
