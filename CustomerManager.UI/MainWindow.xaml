<Window x:Class="CustomerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vmPages="clr-namespace:CustomerManager.ViewModels.Pages"
        xmlns:viewsPages="clr-namespace:CustomerManager.Views.Pages"
        Title="HỆ THỐNG QUẢN LÝ DỰ NỢ KHÁCH HÀNG &amp; THẺ TÍN DỤNG" 
        Height="900" Width="1500" 
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BgApp}">
    
    <!-- CUSTOM WINDOW CHROME HỖ TRỢ KÉO THẢ VÀ RESIZE CỬA SỔ -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" 
                            ResizeBorderThickness="6" 
                            GlassFrameThickness="0" 
                            CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vmPages:OverviewViewModel}">
            <viewsPages:OverviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmPages:CustomerListViewModel}">
            <viewsPages:CustomerListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmPages:LoanPortfolioViewModel}">
            <viewsPages:LoanPortfolioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmPages:CollateralViewModel}">
            <viewsPages:CollateralView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmPages:CreditCardViewModel}">
            <viewsPages:CreditCardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmPages:SettingsViewModel}">
            <viewsPages:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- CUSTOM TITLE BAR & HEADER -->
            <RowDefinition Height="*"/>    <!-- MAIN CONTENT BODY -->
            <RowDefinition Height="Auto"/> <!-- PROFESSIONAL FOOTER -->
        </Grid.RowDefinitions>

        <!-- ==========================================
             1. CUSTOM ENTERPRISE TITLE BAR & HEADER
           ========================================== -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" 
                BorderBrush="{DynamicResource BdCard}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Enterprise Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Background="{DynamicResource Primary}" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="🏦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HỆ THỐNG QUẢN LÝ DỰ NỢ KHÁCH HÀNG &amp; THẺ TÍN DỤNG" 
                                       FontWeight="Bold" FontSize="15" Foreground="{DynamicResource OnSurfacePrimary}" Margin="0,0,10,0"/>
                            <Border Background="{DynamicResource Primary}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="PHIÊN BẢN v2.5" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Phân Hệ Quản Lý Hồ Sơ Khách Hàng, Hợp Đồng Tín Dụng &amp; Tài Sản Bảo Đảm" 
                                   FontSize="12" Foreground="{DynamicResource OnSurfaceSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Info & Custom Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Status Badge -->
                    <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BdCard}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🟢 TRẠNG THÁI: " Foreground="{DynamicResource Success}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="ĐÃ KẾT NỐI DATABASE SUPABASE" Foreground="{DynamicResource OnSurfacePrimary}" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- CUSTOM WINDOW CONTROLS: MINIMIZE, MAXIMIZE, CLOSE -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize Button -->
                        <Button Click="MinimizeWindow_Click" 
                                Content="—" 
                                Width="36" Height="32" 
                                Style="{StaticResource SecondaryButton}" 
                                FontSize="13" Margin="0,0,4,0"/>

                        <!-- Maximize / Restore Button -->
                        <Button Click="MaximizeWindow_Click" 
                                Content="🗖" 
                                Width="36" Height="32" 
                                Style="{StaticResource SecondaryButton}" 
                                FontSize="13" Margin="0,0,4,0"/>

                        <!-- Close Button -->
                        <Button Click="CloseWindow_Click" 
                                Content="✕" 
                                Width="36" Height="32" 
                                Style="{StaticResource DangerButton}" 
                                FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==========================================
             2. MAIN BODY LAYOUT & SIDEBAR NAVIGATION
           ========================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/> <!-- LEFT SIDEBAR -->
                <ColumnDefinition Width="*"/>   <!-- PAGE CONTENT -->
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}" 
                    BorderBrush="{DynamicResource BdCard}" BorderThickness="0,0,1,0" Padding="12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DANH MỤC QUẢN LÝ" Style="{StaticResource LabelText}" Margin="8,0,0,14"/>

                    <ListBox Grid.Row="1" Style="{StaticResource NavListBox}" 
                             SelectedValuePath="Tag"
                             SelectedValue="{Binding SelectedNavTab, Mode=TwoWay}">
                        <ListBoxItem Content="📊 Thống Kê Tổng Quan" Tag="Overview" Style="{StaticResource NavListItemStyle}"/>
                        <ListBoxItem Content="📋 Danh Sách Khách Hàng" Tag="CustomerList" Style="{StaticResource NavListItemStyle}"/>
                        <ListBoxItem Content="💼 Quản Lý Khoản Vay" Tag="Loans" Style="{StaticResource NavListItemStyle}"/>
                        <ListBoxItem Content="🏡 Tài Sản Bảo Đảm" Tag="Collaterals" Style="{StaticResource NavListItemStyle}"/>
                        <ListBoxItem Content="💳 Quản Lý Thẻ Tín Dụng" Tag="CreditCards" Style="{StaticResource NavListItemStyle}"/>
                        <ListBoxItem Content="⚙️ Cài Đặt Giao Diện" Tag="Settings" Style="{StaticResource NavListItemStyle}"/>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Main Page View Content -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="16"/>
        </Grid>

        <!-- ==========================================
             3. PROFESSIONAL ENTERPRISE FOOTER BAR
           ========================================== -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BdCard}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HỆ THỐNG QUẢN LÝ DỰ NỢ KHÁCH HÀNG &amp; PHÂN TÍCH TÍN DỤNG" 
                               Foreground="{DynamicResource OnSurfaceSecondary}" FontSize="12" Margin="0,0,16,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TRẠNG THÁI HỆ THỐNG: HOẠT ĐỘNG BÌNH THƯỜNG" 
                               Foreground="{DynamicResource Success}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>